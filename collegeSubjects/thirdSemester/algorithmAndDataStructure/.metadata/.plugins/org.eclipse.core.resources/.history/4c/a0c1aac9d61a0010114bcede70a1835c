package model.entities;

import model.exception.FilaCheiaException;
import model.exception.FilaVaziaException;

public class FilaDeque<T> implements FilaD<T> {
	private Object[] info;
	private int limite;
	private int tamanho;
	private int inicio;
	private int fim;

	@SuppressWarnings("unchecked")
	public FilaDeque(int limite) {
		this.limite = limite;
		this.info = (T[]) new Object[limite];
		this.tamanho = 0;
		this.fim = -1;
		this.inicio = 0;
	}

	@Override
	public void inserir(T valor) {
		if (tamanho == limite) {
			throw new FilaCheiaException();
		}
		if(tamanho == 0) {
			info[inicio] = valor;
			fim++;
		} else {
			info[++fim] = valor;
		}
		tamanho++;
	}
	
	@Override
	public void inserirInicio(T valor) {
		if (tamanho == limite) {
			throw new FilaCheiaException();
		}
		if(tamanho == 0) {
			info[inicio] = valor;
			fim++;
		} else {
			if(inicio - 1 < 0) {
				inicio = limite - 1;
				info[inicio] = valor;
			} else {
				info[--inicio] = valor;
			}
		}
		tamanho++;
	}

	@Override
	public boolean estaVazia() {
		return tamanho == 0;
	}

	@SuppressWarnings("unchecked")
	@Override
	public T peek() {
		if (estaVazia()) {
			throw new FilaVaziaException();
		}
		return (T) info[inicio];
	}

	@SuppressWarnings("unchecked")
	@Override
	public T retirar() {
		int pos = inicio;
		if (estaVazia()) {
			throw new FilaVaziaException();
		}
		if (tamanho >= 1 && inicio + 1 > limite) {
			inicio = 0;
		} else {
			inicio++;
		}
		tamanho--;
		return (T) info[pos];
	}

	@Override
	public void liberar() {
		while (!estaVazia()) {
			retirar();
		}
	}

	public FilaDeque<T> criarFilaConcatenada(FilaDeque<T> f2) {
		FilaDeque<T> f3 = new FilaDeque<>(getLimite() + f2.getLimite());
		int fim = ((inicio + tamanho) % limite) - 1;
		int temp = inicio;
		while (inicio <= fim) {
			f3.inserir(peek());
			inicio++;
		}
		int fim1 = ((f2.inicio + f2.tamanho) % f2.limite) - 1;
		int temp1 = f2.inicio;
		while (f2.inicio <= fim1) {
			f3.inserir(f2.peek());
			f2.inicio++;
		}
		inicio = temp;
		f2.inicio = temp1;
		return f3;

	}

	public int getLimite() {
		return limite;
	}

	@Override
	public String toString() {
		StringBuilder sb = new StringBuilder();
		int temp = inicio;
		while (!(temp == fim + 1)) {
			sb.append(info[temp]);
			if(!(temp == fim)) {
				sb.append(", ");
			}
			if(temp == limite - 1) {
				temp = 0;
			} else {
				temp++;
			}
		}
		if(estaVazia()) {
			sb.append("Fila vazia!");
		}
		return sb.toString();
	}
	
	public void deque() {
		
	}

	@Override
	public T retirarFinal() {
		int pos = fim;
		if (estaVazia()) {
			throw new FilaVaziaException();
		}
		if (--fim != -1) {
			--fim;
		} else {
			fim = limite - 1;
		}
		tamanho--;
		return (T) info[pos];
	}
	}

}
