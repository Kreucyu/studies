package model;

public class listaDupla<T> {
	private noListaDupla<T> primeiro;

	public noListaDupla<T> getPrimeiro() {
		return primeiro;
	}

	public void inserir(T valor) {
		noListaDupla<T> insert = new noListaDupla<>();
		insert.setInfo(valor);
		insert.setProximo(primeiro);
		insert.setAnterior(null);
		if (primeiro != null) {
			primeiro.setAnterior(insert);
		}
		primeiro = insert;
	}

	public noListaDupla<T> buscar(T valor) {
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			if (atual.getInfo().equals(valor) || atual.getInfo().toString().equals(valor.toString())) {
				return atual;
			}
			atual = atual.getProximo();
		}
		return null;
	}

	public void retirar(T valor) {
		noListaDupla<T> atual = primeiro;
		if (atual == null) {
			return;
		}

		if (atual.getInfo().equals(valor)) {
			primeiro = atual.getProximo();
			if (primeiro != null) {
				primeiro.setAnterior(null);
				return;
			}
		}

		while (atual != null && !atual.getInfo().equals(valor)) {
			atual = atual.getProximo();
		}

		if (atual != null) {
			if (atual.getProximo() == null) {
				atual.getAnterior().setProximo(null);
			} else {
				atual.getAnterior().setProximo(atual.getProximo());
				atual.getProximo().setAnterior(atual.getAnterior());
			}
		}
	}

	

	public void liberar() {
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			noListaDupla<T> temp = atual.getProximo();
			atual.setAnterior(null);
			atual.setProximo(null);
			atual = temp;
		}
		primeiro = null;
	}
	
	public void exibirOrdemInversa() {
	    noListaDupla<T> atual = primeiro;
	    noListaDupla<T> temp = null;

	    // Inversão dos ponteiros da lista
	    while (atual != null) {
	        temp = atual.getProximo();  // Salva o próximo nó
	        atual.setProximo(atual.getAnterior());  // Inverte o ponteiro "proximo"
	        atual.setAnterior(temp);  // Inverte o ponteiro "anterior"
	        atual = temp;  // Avança para o próximo nó (agora que o próximo é o anterior)
	    }

	    // Após a inversão, o primeiro nó será o último nó da lista original
	    if (primeiro != null) {
	        primeiro = primeiro.getAnterior();  // Atualiza o primeiro nó
	    }

	    // Exibindo a lista invertida
	    System.out.print("\nLista invertida: ");
	    atual = primeiro;  // Agora, "atual" aponta para o novo primeiro nó

	    // Se a lista for vazia, o primeiro será null, então podemos verificar isso
	    if (atual == null) {
	        System.out.println("A lista está vazia.");
	        return;  // Se estiver vazia, retornamos sem fazer mais nada
	    }

	    while (atual != null) {
	        System.out.print(atual.getInfo());  // Imprime o valor do nó
	        if (atual.getProximo() != null) {
	            System.out.print(", ");  // Adiciona vírgula se não for o último nó
	        }
	        atual = atual.getProximo();  // Avança para o próximo nó
	    }
	    System.out.println("\n");
	}


	@Override
	public String toString() {
		StringBuilder sb = new StringBuilder();
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			sb.append(atual.getInfo());
			if (atual.getProximo() != null) {
				sb.append(", ");
			}
			atual = atual.getProximo();
		}
		return sb.toString();
	}

	public void exit() {
		System.out.println("\nSaindo...");
		System.exit(0);
	}

	public void imprimir() {
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			System.out.println("Valor: " + atual.getInfo() + "\n");
			System.out.println("Anterior: " + (atual.getAnterior() != null ? atual.getAnterior().getInfo() : "null"));
			System.out.println("Primeiro: " + atual.getInfo());
			System.out
					.println("Próximo: " + (atual.getProximo() != null ? atual.getProximo().getInfo() : "null") + "\n");
			System.out.println("--------------------------------------");
			atual = atual.getProximo();
		}
	}

}
