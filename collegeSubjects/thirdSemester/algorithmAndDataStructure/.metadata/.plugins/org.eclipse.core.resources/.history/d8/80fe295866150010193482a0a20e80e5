package application;

import model.listaEstatica;

public class app {

	public static void main(String[] args) {
		listaEstatica<Object> list = new listaEstatica<>();
		list.inserir(10);
		list.inserir(20);
		list.inserir(30);
		list.inserir(40);
		list.inserir(50);
		list.inserir(60);
		System.out.println("Lista antes da remoção: " + list.toString());
		try {
			list.retirarElementos(2, 11);
		} catch (IndexOutOfBoundsException e) {
			System.out.println("\nPosição inválida");
		}
		System.out.println("\nLista depois da remoção: " + list.toString());
		
	}
}
