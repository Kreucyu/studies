	}
	
	public FilaVetor<T> criarFilaConcatenada(FilaVetor<T> f2) {
		return null;
		
	}

	public int getLimite() {
		return limite;
	}

	@Override
	public String toString() {
		return "FilaVetor [info=" + Arrays.toString(info) + ", limite=" + limite + ", tamanho=" + tamanho + ", inicio="
				+ inicio + "]";
	}
	
	

}
