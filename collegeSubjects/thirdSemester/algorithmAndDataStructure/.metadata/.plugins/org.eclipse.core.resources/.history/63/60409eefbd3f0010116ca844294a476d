package entities;

public class MapaDispersao<T> {
	private ListaEncadeada<NoMapa<T>> info[];
	
	@SuppressWarnings("unchecked")
	public MapaDispersao(int tamanho) {
		info = new ListaEncadeada[tamanho];
	}
	
	private int calcularHash(int chave) {
		int tamanho = info.length;
		return chave % tamanho;
	}
	
	public void inserir(int chave, T dado) {
		int indice = calcularHash(chave);
		if(info[indice] == null) {
			info[indice] = new ListaEncadeada<NoMapa<T>>();
		}
		
		NoMapa<T> no = new NoMapa<T>();
		no.setChave(chave);
		no.setValor(dado);
		
		info[indice].inserir(no);
	}
	
	public void remover(int chave) {
		int indice = calcularHash(chave);
		NoMapa<T> no = new NoMapa<T>();
		no.setChave(chave);
		info[indice].retirar(no);
	}
	
	public T buscar(int chave) {
		int indice = calcularHash(chave);
		if(info[indice] != null) {
			NoMapa<T> no = new NoMapa<T>();
			no.setChave(chave);
			NoLista<NoMapa<T>> busca = info[indice].buscar(no);
			if(busca != null) {
				return busca.getInfo().getValor();
			}
		}
		return null;
	}
	
	public double calcularFatorCarga() {
		double elementos = 0;
		for(ListaEncadeada<NoMapa<T>> lista : info) {
			if(lista.estaVazia()) elementos += lista.obterComprimento();
		}
		return elementos / info.length;
	}
}