package application;

import java.util.Scanner;

import model.listaDupla;

public class app {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		listaDupla<Object> list = new listaDupla<>();
		Object value = null;
		int type = 0;
		
		do {
			System.out.println("Escolha uma opção:\n");
			System.out.println("1 - Inserir");
			System.out.println("2 - Buscar");
			System.out.println("3 - Remover");
			System.out.println("4 - Inverter");
			System.out.println("5 - Exibir Lista");
			System.out.println("6 - Liberar Lista");
			System.out.println("7 - Verificar Anterior e Próximo");
			System.out.println("8 - Sair");
			System.out.print("\nOpção: ");
			type = sc.nextInt();
			
			switch(type) {
			case 1:
				System.out.print("\nDigite o valor que deseja inserir: ");
				value = sc.nextInt();
				list.inserir(value);
				System.out.println("\nValor inserido!\n");
				break;
			case 2:
				System.out.print("\nDigite o valor que deseja buscar: ");
				value = sc.nextInt();
				if (list.buscar(value) != null) {
					System.out.println("\nValor encontrado, busca = "+ list.buscar(value).getInfo() + "\n");
				} else {
					System.out.println("\nValor não encontrado, busca = " + list.buscar(value) + "\n");
				}
				break;
			case 3:
				System.out.print("\nDigite o valor que deseja remover: ");
				value = sc.nextInt();
				list.retirar(value);
				System.out.println("\nValor removido!\n");
				break;
			case 4:
				System.out.print("\nDigite o nó que deseja buscar: ");
				int idx = sc.nextInt();
				if(list.obterNo(idx) != null) {
					System.out.println("\nNó " + idx + ", valor encontrado: " + list.obterNo(idx).getInfo() + "\n");
				}
				break;
			case 5:
				System.out.println("\n" + list.toString() + "\n");
				break;
			case 6:
				if(list.estaVazia() == false) {
					System.out.println("\nA lista não está vazia, estado = " + list.estaVazia() + "\n");
				} else {
					System.out.println("\nA lista está vazia, estado = " + list.estaVazia() + "\n");
				}
				break;
			case 7:
				System.out.println("\nO comprimento da lista é " + list.obterComprimento() + "\n");
				break;
			case 8:
				list.exit();
				break;
			default:
				System.out.println("\nInsira um valor válido!\n");
				break;
			}
		} while (type != 8);
		
		do {
			System.out.print("num: ");
			type = sc.nextInt();
			if(type == 1) {
				
			}
			if(type == 2) {
				
				break;
			}
			
			
		} while(type != 3);
		
		sc.close();
		
	}
}

