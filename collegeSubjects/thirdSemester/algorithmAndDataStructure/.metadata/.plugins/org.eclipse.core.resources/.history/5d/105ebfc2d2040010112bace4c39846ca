package application;

import java.util.Scanner;

import model.listaEncadeada;

public class app {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		listaEncadeada<Object> list = new listaEncadeada<>();
		Object value = null;
		int type = 0;
		do {
			System.out.println("Escolha uma opção:\n");
			System.out.println("1 - Inserir");
			System.out.println("2 - Buscar");
			System.out.println("3 - Remover");
			System.out.println("4 - Buscar nó");
			System.out.println("5 - Exibir lista");
			System.out.println("6 - Verificar lista");
			System.out.println("7 - Obter comprimento");
			System.out.println("8 - Sair");
			System.out.print("\nOpção: ");
			type = sc.nextInt();
			
			switch(type) {
			case 1:
				System.out.print("\nDigite o valor que deseja inserir: ");
				value = sc.nextInt();
				list.inserir(value);
				System.out.println("Valor inserido! \n");
				break;
			case 2:
				System.out.println("\nDigite o valor que deseja buscar: ");
				value = sc.nextInt();
				if (list.buscar(value) != null) {
					System.out.println("Valor encontrado, busca = "+ list.buscar(value).getInfo());
				} else {
					System.out.println("Valor não encontrado, busca = " + list.buscar(value));
				}
				break;
			case 3:
				System.out.println("\nDigite o valor que deseja remover: ");
				value = sc.nextInt();
				list.retirar(value);
				break;
			case 4:
				System.out.println("\nDigite o nó que deseja buscar: ");
				int idx = sc.nextInt();
				list.obterNo(idx);
				break;
			case 5:
				System.out.println(list.toString());
				break;
			case 6:
				if(list.estaVazia() == false) {
					System.out.println("A lista não está vazia, estado = " + list.estaVazia() + "\n");
				} else {
					System.out.println("A lista está vazia, estado = " + list.estaVazia() + "\n");
				}
				break;
			case 7:
				System.out.println("O comprimento da lista é " + list.obterComprimento());
				break;
			case 8:
				list.exit();
				break;
			default:
				System.out.println("\nInsira um valor válido!\n");
				break;
			}
		} while (type != 8);
		sc.close();
		
	}
}

