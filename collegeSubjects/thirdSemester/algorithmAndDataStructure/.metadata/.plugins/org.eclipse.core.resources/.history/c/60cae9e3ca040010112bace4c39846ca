package model;

public class listaEncadeada<T> {
	private noLista<T> primeiro;

	public listaEncadeada() {
		primeiro = null;
	}

	public noLista<T> getPrimeiro() {
		return primeiro;
	}

	public void inserir(T valor) {
		noLista<T> insert = new noLista<>();
		insert.setInfo(valor);
		insert.setProximo(primeiro);
		primeiro = insert;
	}

	public boolean estaVazia() {
		return primeiro == null;
	}

	public noLista<T> buscar(T valor) {
		noLista<T> atual = primeiro;
		try {
			while (atual != null) {
				if(atual.getInfo().equals(valor)) {
					return atual;
				}
				atual = atual.getProximo();
			}
				
		} catch (NullPointerException e) {
			System.out.println("Nenhum valor encontrado!" + e.getMessage());
		}
		return null;
	}
		

	public void retirar(T valor) {
		noLista<T> atual = primeiro;
		noLista<T> anterior = null;
		while(atual != null && !atual.getInfo().equals(valor)) {
			anterior = atual;
			atual = atual.getProximo();
		}
		if (atual != null) {
			if(anterior == null) {
				primeiro = atual.getProximo();
			} else {
				anterior.setProximo(atual.getProximo());
			}
		}
		
	}

	public int obterComprimento() {
		return 1;
	}

	public noLista<T> obterNo(int idx) {
