package entities;

public class BuscaLinearVetorOrdenado<T extends Comparable<T>> extends BuscaAbstract {
	public int buscar(T valor) {
		Object[] info = getInfo();
		int n = info.length;
		for(int i = 0; i < n - 1; i++) {
			@SuppressWarnings("unchecked")
			T atual = (T) info[i];
			if(info[i].equals(atual)) {
				return i;
			} else if (valor.compareTo(atual) < 0) {
				break;
			}
		}
		return -1;
	}
}
