
package application;

import javafx.fxml.FXML;
import javafx.stage.FileChooser;
import javafx.stage.Stage;
import java.io.File;
import javafx.scene.control.Button;
import javafx.scene.control.TextArea;
import javafx.scene.control.TextField;
import model.entities.OrdenacaoMergeSort;
import model.entities.PilhaLista;
import model.entities.TagContador;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Controlador principal da interface JavaFX responsável por validar arquivos HTML.
 * 
 * Esta classe gerencia os elementos da interface definidos no arquivo FXML, 
 * permitindo ao usuário selecionar um arquivo HTML e verificar se todas as tags 
 * estão corretamente abertas e fechadas.
 *
 * A validação utiliza uma pilha para verificar o correto pareamento das tags e 
 * vetores auxiliares para registrar:
 * - Ocorrências de tags HTML (com uso da classe {@code TagContador});
 * - Erros estruturais (tags não fechadas ou fechadas incorretamente);
 * - Controle de tags já reportadas para evitar duplicações nos erros.
 *
 * As tags singleton (auto-fechamento) são desconsideradas durante a validação.
 * 
 * Caso o HTML seja considerado bem formatado, as tags encontradas são ordenadas 
 * em ordem decrescente de frequência utilizando o algoritmo MergeSort.
 */


public class Controller {

	// Campos utilizados na interface para exibir e receber os dados.

	@FXML
	private TextField campoCaminho;
	@FXML
	private Button botaoValidar;
	@FXML
	private TextArea saidaErros;
	@FXML
	private TextArea saidaTags;

	private Stage stage;

	public void setStage(Stage stage) {
		this.stage = stage;
	}

	/**
	 * Abre uma janela para o usuário selecionar um arquivo HTML.
	 * O caminho do arquivo selecionado será exibido no campo de texto.
	 */

	@FXML
	private void abrirFileChooser() {
		FileChooser fileChooser = new FileChooser();
		fileChooser.setTitle("Selecionar Arquivo HTML");
		fileChooser.getExtensionFilters()
				.add(new FileChooser.ExtensionFilter("Arquivos HTML (*.html, *.htm)", "*.html", "*.htm"));

		File arquivo = fileChooser.showOpenDialog(stage);
		if (arquivo != null) {
			campoCaminho.setText(arquivo.getAbsolutePath());
		}
	}

	// Definição das tags de fechamento único, de acordo com o enunciado.

	private static final String[] SINGLETON_TAGS = { "meta", "base", "br", "col", "command", "embed", "hr", "img",
			"input", "link", "param", "source", "!doctype" };

	private boolean isSingleton(String tag) {
		for (String s : SINGLETON_TAGS) {
			if (s.equalsIgnoreCase(tag))
				return true;
		}
		return false;
	}

	/**
	 * Valida a estrutura de um arquivo HTML informado.
	 * Lê as tags do arquivo, verifica se todas estão corretamente fechadas
	 * e exibe os erros ou o relatório de tags ordenado por nome.
	 */

	@FXML
	private void validarArquivo() {
		saidaErros.clear();
		saidaTags.clear();
		String caminho = campoCaminho.getText();

		String[] tagsFechadasErradas = new String[100];
		int tagsErradasIndex = 0;

		// Inicialização da pilha.
		PilhaLista<String> pilha = new PilhaLista<>();
		// Inicialização do contador de tags.
		TagContador[] contagem = new TagContador[500];
		int contagemIndex = 0;

		// Inicializa a lista de erros detectados na análise do HTML.
		String[] erros = new String[100];
		int erroIndex = 0;

		try (BufferedReader leitor = new BufferedReader(new FileReader(caminho))) {
			// Lê o conteúdo completo do arquivo e armazena em uma String para posterior
			// análise.
			String linha;
			StringBuilder sbHtml = new StringBuilder();

			while ((linha = leitor.readLine()) != null) {
				sbHtml.append(linha).append("\n");
			}
			leitor.close();
			// Remove comentários e extrai as tags do HTML para análise.
			String html = sbHtml.toString().replaceAll("<!--.*?-->", "").toLowerCase();
			Pattern padrao = Pattern.compile("<\\s*/?\\s*([a-zA-Z0-9]+)([^<>]*?)>", Pattern.DOTALL);
			Matcher matcher = padrao.matcher(html);

			// Itera por todas as tags encontradas no conteúdo HTML
			while (matcher.find()) {
				String tagCompleta = matcher.group(0);
				String nomeTag = matcher.group(1).toLowerCase();

				if (isSingleton(nomeTag))
					continue; // Ignora tags do tipo singleton, que não requerem fechamento.

				if (tagCompleta.startsWith("</")) {
					String tagFinal = nomeTag;
					// Se a tag no topo da pilha não corresponder à tag de fechamento atual,
					// registra um erro informando a esperada e a encontrada.
					if (pilha.estaVazia()) {
						erros[erroIndex++] = "Tag de fechamento </" + tagFinal + "> sem abertura.";
					} else {
						String topo = pilha.peek();
						if (topo.equals(tagFinal)) {
							pilha.pop();
						} else {
							// Se a tag de fechamento encontrada não corresponder à esperada, registra a divergência.
							erros[erroIndex++] = "Esperava </" + topo + ">, mas encontrou </" + tagFinal + ">.";
							tagsFechadasErradas[tagsErradasIndex++] = topo;
							tagsFechadasErradas[tagsErradasIndex++] = tagFinal;
							pilha.pop();
						}
					}
				} else {
					pilha.push(nomeTag);
					// Verifica se a tag já foi registrada para incrementar sua contagem
					boolean existe = false;
					for (int i = 0; i < contagemIndex; i++) {
						if (contagem[i].nome.equalsIgnoreCase(nomeTag)) {
							contagem[i].quantidade++;
							existe = true;
							break;
						}
					}
					if (!existe)
						contagem[contagemIndex++] = new TagContador(nomeTag);
				}
			}

			// Verifica se ainda restaram tags na pilha que não foram fechadas corretamente.
			while (!pilha.estaVazia()) {
				String tag = pilha.pop();
				boolean jaReportada = false;
				for (int i = 0; i < tagsErradasIndex; i++) {
					if (tagsFechadasErradas[i].equalsIgnoreCase(tag)) {
						jaReportada = true;
						break;
					}
				}
				// Se a tag não tiver fechamento correspondente, registra um erro.
				if (!jaReportada) {
					erros[erroIndex++] = "Tag <" + tag + "> sem fechamento.";
				}
			}
			// Se não houver erros, exibe uma mensagem de sucesso e inicia a ordenação com MergeSort.
			if (erroIndex == 0) {
				saidaErros.setText("Arquivo bem formatado!");
				OrdenacaoMergeSort<TagContador> ordena = new OrdenacaoMergeSort<>();
				TagContador[] ordenado = new TagContador[contagemIndex];
				for (int i = 0; i < contagemIndex; i++)
					ordenado[i] = contagem[i];
				ordena.setInfo(ordenado);
				ordena.ordenar();
				// Exibe as tags ordenadas na interface após a ordenação.
				StringBuilder sb = new StringBuilder();
				for (TagContador tag : ordena.getInfo()) {
					sb.append("<").append(tag.nome).append(">: ").append(tag.quantidade).append("\n");
				}
				saidaTags.setText(sb.toString());
			} else {
				// Se foram detectados erros, exibe todos na interface indicando que o arquivo está mal formatado.
				StringBuilder sb = new StringBuilder("Arquivo mal formatado:\n");
				for (int i = 0; i < erroIndex; i++) {
					sb.append(erros[i]).append("\n"); // Exibição dos erros.
				}
				saidaErros.setText(sb.toString());
			}

		} catch (IOException e) { // Caputura de erros caso o arquivo não seja lido ou seja inválido.
			if (caminho == null || caminho.trim().isEmpty())
				saidaErros.setText("Erro: Nenhum arquivo foi selecionado!"); // Condicional que verifica se nenhum arquivo foi
																				// selecionado.
			else
				saidaErros.setText("Erro ao ler o arquivo: " + e.getMessage());
		}
	}
}
