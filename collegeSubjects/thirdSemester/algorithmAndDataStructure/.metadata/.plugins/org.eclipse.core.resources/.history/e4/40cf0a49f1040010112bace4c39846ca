package model;

public class listaDupla<T> {
	private noListaDupla<T> primeiro;

	public noListaDupla<T> getPrimeiro() {
		return primeiro;
	}

	public void inserir(T valor) {
		noListaDupla<T> insert = new noListaDupla<>();
		insert.setInfo(valor);
		insert.setProximo(primeiro);
		insert.setAnterior(null);
		if (primeiro != null) {
			primeiro.setAnterior(insert);
		}
		primeiro = insert;
	}

	public noListaDupla<T> buscar(T valor) {
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			if (atual.getInfo().equals(valor) || atual.getInfo().toString().equals(valor.toString())) {
				return atual;
			}
			atual = atual.getProximo();
		}
		return null;
	}

	public void retirar(T valor) {
		noListaDupla<T> atual = primeiro;
		if (atual == null) {
			return;
		}

		if (atual.getInfo().equals(valor)) {
			primeiro = atual.getProximo();
			if (primeiro != null) {
				primeiro.setAnterior(null);
			}
			return;
		}

		while (atual != null && !atual.getInfo().equals(valor)) {
			atual = atual.getProximo();
		}

		if (atual != null) {
			if (atual.getProximo() == null) {
				atual.getAnterior().setProximo(null);
			} else {
				atual.getAnterior().setProximo(atual.getProximo());
				atual.getProximo().setAnterior(atual.getAnterior());
			}
		}
	}

	public void liberar() {
		noListaDupla<T> atual = primeiro;
		while (atual != null) {
			noListaDupla<T> temp = atual.getProximo();
			atual.setAnterior(null);
			atual.setProximo(null);
			atual = temp;
		}
		primeiro = null;
	}

	public void exibirOrdemInversa() {
		noListaDupla<T> atual = primeiro;
		
		if (atual == null) {
			System.out.print("\nA lista está vazia\n");

		}

		while (atual.getProximo() != null) {
			atual = atual.getProximo();
		}
		
		System.out.print("\nLista invertida: ");
		atual = primeiro;
		while (atual != null) {
			System.out.print(atual.getInfo());
			if (atual.getAnterior() != null) {
				System.out.print(", ");
			}
			atual = atual.getProximo();
		}
		System.out.println("\n");
	}

	@Override
	public String toString() {
		StringBuilder sb = new StringBuilder();
		noListaDupla<T> atual = primeiro;
		if(atual == null) {
			sb.append("A lista está vazia!");
			return sb.toString();
		}
		while (atual != null) {
			sb.append(atual.getInfo());
			if (atual.getProximo() != null) {
				sb.append(", ");
			}
			atual = atual.getProximo();
		}
		return sb.toString();
	}

	public void exit() {
		System.out.println("\nSaindo...");
		System.exit(0);
	}

	public void imprimir() {
		noListaDupla<T> atual = primeiro;
		if(atual == null) {
			System.out.println("\nA lista está vazia!\n");
		}
		while (atual != null) {
			if (atual == primeiro) {System.out.println("\n--------------------------------------\n");} 
			System.out.println("Valor: " + atual.getInfo() + "\n");
			System.out.println("Anterior: " + (atual.getAnterior() != null ? atual.getAnterior().getInfo() : "null"));
			System.out.println("Primeiro: " + atual.getInfo());
			System.out
					.println("Próximo: " + (atual.getProximo() != null ? atual.getProximo().getInfo() : "null") + "\n");
			System.out.println("--------------------------------------\n");
			atual = atual.getProximo();
		}
	}

}
