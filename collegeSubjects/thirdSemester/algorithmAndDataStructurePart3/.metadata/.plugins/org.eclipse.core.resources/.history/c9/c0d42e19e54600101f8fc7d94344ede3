	// São permutações (dois arrays são permutações um do outro)
	public boolean saoPermutacoes(T[] outroArray) {
		if (this.info == null || outroArray == null || this.info.length != outroArray.length) {
			return false;
		}

		// Cria cópias e ordena para comparar
		T[] temp1 = (T[]) new Comparable[this.info.length];
		System.arraycopy(this.info, 0, temp1, 0, this.info.length);
		T[] temp2 = (T[]) new Comparable[outroArray.length];
		System.arraycopy(outroArray, 0, temp2, 0, outroArray.length);

		// Usa um algoritmo de ordenação para as cópias
		// (Para este exemplo, usaremos Collections.sort em listas temporárias para simplicidade)
		java.util.ArrayList<T> list1 = new java.util.ArrayList<>(java.util.Arrays.asList(temp1));
		java.util.ArrayList<T> list2 = new java.util.ArrayList<>(java.util.Arrays.asList(temp2));

		java.util.Collections.sort(list1);
		java.util.Collections.sort(list2);

		for (int i = 0; i < list1.size(); i++) {
			comparacoes++; // Conta a comparação
			if (list1.get(i).compareTo(list2.get(i)) != 0) {
				return false;
			}
		}
		return true;
	}


	// Ordenar por ocorrência (ex: elementos mais frequentes primeiro)
	public void ordenarPorOcorrencia() {
		if (info == null || info.length == 0) {
			return;
		}

		java.util.Map<T, Integer> frequencia = new java.util.HashMap<>();
		for (T item : info) {
			frequencia.put(item, frequencia.getOrDefault(item, 0) + 1);
		}

		// Ordena com base na frequência e depois no valor
		java.util.Arrays.sort(info, (o1, o2) -> {
			int cmpFrequencia = frequencia.get(o2).compareTo(frequencia.get(o1)); // Decrescente por frequência
			if (cmpFrequencia == 0) {
				return o1.compareTo(o2); // Crescente por valor se frequências forem iguais
			}
			return cmpFrequencia;
		});
	}

	public abstract void ordenar();
}