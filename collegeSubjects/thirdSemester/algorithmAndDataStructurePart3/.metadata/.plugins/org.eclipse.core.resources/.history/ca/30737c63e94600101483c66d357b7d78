     } else {
         System.out.println("Caso 3 FALHA: Aluno 12000 (Jean) não encontrado ou não é o mesmo.");
         caso3Sucesso = false;
     }

     Aluno bPedro3 = mapa3.buscar(14000);
     // Os objetos retornados devem ser os mesmos que foram originalmente adicionados ao mapa de dispersão.
     if (bPedro3 != null && bPedro3.equals(alunoPedro3)) {
         System.out.println("Aluno 14000 (Pedro) encontrado: " + bPedro3);
     } else {
         System.out.println("Caso 3 FALHA: Aluno 14000 (Pedro) não encontrado ou não é o mesmo.");
         caso3Sucesso = false;
     }

     Aluno bMarta3 = mapa3.buscar(14226);
     // Os objetos retornados devem ser os mesmos que foram originalmente adicionados ao mapa de dispersão.
     if (bMarta3 != null && bMarta3.equals(alunoMarta3)) {
