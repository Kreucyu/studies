     } else {
         System.out.println("Caso 3 FALHA: Aluno 17180 (Lucas) não encontrado ou não é o mesmo.");
         caso3Sucesso = false;
     }

     if (caso3Sucesso) {
         System.out.println("Caso 3 SUCESSO: Todos os alunos foram encontrados corretamente, mesmo com colisões.");
     }

     // Teste de Remoção (adicional para endereçamento aberto)
     System.out.println("\n--- Teste de Remoção (adicional) ---");
     mapa3.remover(12000); // Remove Jean
     mapa3.imprimirMapa();
     Aluno bJeanRemovido = mapa3.buscar(12000);
     if (bJeanRemovido == null) {
         System.out.println("Remoção SUCESSO: Aluno 12000 (Jean) não encontrado após remoção.");
     } else {
         System.out.println("Remoção FALHA: Aluno 12000 (Jean) ainda encontrado após remoção.");
     }

     Aluno bMartaAposRemocao = mapa3.buscar(14226); // Marta deveria ainda ser encontrada
     if (bMartaAposRemocao != null && bMartaAposRemocao.equals(alunoMarta3)) {
