     }


     // Caso 3: Validar inserção e busca de objetos quando há colisão 
     System.out.println("\n--- Caso 3: Inserção e Busca com Colisões (Endereçamento Aberto) ---");
     // Crie um mapa de dispersão com capacidade de armazenamento de 53 listas encadeadas (aqui, 53 slots).
     MapaDispersao<Aluno> mapa3 = new MapaDispersao<>(53);

     // Armazenar os seguintes alunos:
     Aluno alunoJean3 = new Aluno(12000, "Jean", LocalDate.of(2000, 1, 1)); // 
     Aluno alunoPedro3 = new Aluno(14000, "Pedro", LocalDate.of(1999, 1, 20)); // 
     // O objeto de matrícula 14226 colidirá com o objeto de matrícula 12000.
     Aluno alunoMarta3 = new Aluno(14226, "Marta", LocalDate.of(2001, 2, 18)); // 
     // O objeto de matrícula 17180 colidirá com o aluno de matrícula 14000.
     Aluno alunoLucas3 = new Aluno(17180, "Lucas", LocalDate.of(1998, 11, 25)); // 

     // Para garantir as colisões para o tamanho 53:
     // 12000 % 53 = 30
     // 14226 % 53 = 30  -> Colide com 12000
     // 14000 % 53 = 32
     // 17180 % 53 = 32 -> Colide com 14000

     mapa3.inserir(alunoJean3.getMatricula(), alunoJean3);
     mapa3.inserir(alunoPedro3.getMatricula(), alunoPedro3);
     mapa3.inserir(alunoMarta3.getMatricula(), alunoMarta3); // Colisão esperada com 12000
     mapa3.inserir(alunoLucas3.getMatricula(), alunoLucas3); // Colisão esperada com 14000
     mapa3.imprimirMapa();

     System.out.println("Fator de Carga: " + mapa3.calcularFatorCarga());

