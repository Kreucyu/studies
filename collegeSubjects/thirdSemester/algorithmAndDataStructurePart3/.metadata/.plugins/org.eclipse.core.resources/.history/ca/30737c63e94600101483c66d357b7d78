     System.out.println("--- Executando Plano de Testes PL01 (Endereçamento Aberto) ---");

     // Caso 1: Validar que o método insere um dado novo e consegue localizá-lo 
     System.out.println("\n--- Caso 1: Inserção e Busca de um único elemento ---");
     // Criar um mapa de dispersão com capacidade de armazenamento de 53 listas encadeadas (aqui, 53 slots).
     MapaDispersao<Aluno> mapa1 = new MapaDispersao<>(53);

