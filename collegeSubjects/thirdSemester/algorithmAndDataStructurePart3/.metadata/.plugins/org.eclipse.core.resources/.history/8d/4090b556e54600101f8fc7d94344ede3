package entities;

public class OrdenacaoBolha<T extends Comparable<T>> extends OrdenacaoAbstract<T> {

	@Override
	public void ordenar() {
		if (getInfo() == null || getInfo().length <= 1) {
			return;
		}
		trocas = 0; // Reinicia o contador de trocas
		comparacoes = 0; // Reinicia o contador de comparações
		int n = getInfo().length;
		for(int i = 0; i < n - 1; i++) {
			for(int j = 0; j < n - 1 - i; j++) {
				comparacoes++; // Conta a comparação
				if(getInfo()[j].compareTo(getInfo()[j+1]) > 0) {
					trocar(j,j+1); // Chama o método trocar da classe abstrata, que incrementa 'trocas'
				}
			}
		}	
	}

	@Override
	public void ordenarSegmento(int inicio, int fim) {
		if (getInfo() == null || inicio < 0 || fim >= getInfo().length || inicio >= fim) {
			return;
		}
		trocas = 0; // Reinicia o contador de trocas para o segmento
		comparacoes = 0; // Reinicia o contador de comparações para o segmento
		for(int i = inicio; i <= fim; i++) {
			// Ajusta o limite superior do loop interno para o segmento
			for(int j = inicio; j < fim - (i - inicio); j++) {
				comparacoes++; // Conta a comparação
				if(getInfo()[j].compareTo(getInfo()[j+1]) > 0) {
					trocar(j,j+1);
				}
			}
		}
	}
}