package entities;

public abstract class BuscaAbstract {
	private Object[] info;
	protected int comparacoes; // Added to count comparisons

	public Object[] getInfo() {
		return info;
	}

	public void setInfo(Object[] info) {
		this.info = info;
		this.comparacoes = 0; // Reset comparisons when info is set
	}

	public int getComparacoes() {
		return comparacoes;
	}
}